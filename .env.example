# Copy to .env locally. Never commit secrets. Never put a DSN in this file.

PORT=8080

# Tenant-registry Neon for this product only. Local gitignored .env / local.database_url.
# DATABASE_URL=
HAUSKA_RETRIEVAL_URL=https://hauska-retrieval-api-h7gvu7rgcq-uc.a.run.app
SMARTSITE_EMBED_ORIGIN=https://smartsite.cloud
SMART_FILES_BACKEND_URL=https://smart-files-padrd77ava-ue.a.run.app

# Optional. If set, /api/city-packs requires Authorization: Bearer. Unset keeps local scaffold open.
# DASHBOARDS_API_KEY=

# Hauska tenant-key resolution (src/tenancy.mjs, resolveHauskaTenant). Required for any
# tenant-private pack (e.g. bastrop_tx) to unlock for a caller. On Cloud Run (K_SERVICE
# set) this is ALWAYS a live call: the caller presents a raw key value in the x-hauska-key
# request header, this service forwards it to HAUSKA_MCP_URL's own /auth/whoami, and
# whatever jurisdiction_tenant comes back is the caller's tenant. There is no server-side
# env var that holds "the" tenant key for that path -- the key lives in hauska-mcp-server's
# own api_keys store (a different repo/seat), not here, and a lane presents it per request.
HAUSKA_MCP_URL=https://hauska-mcp-server-h7gvu7rgcq-uc.a.run.app

# To obtain a bastrop_tx-scoped key for lane verification: see doc_repo
# _catalog/credential_access_index.json (owner: substrate seat, minted via
# hauska-mcp-server's admin API). Never reuse the operator's own personal pilot
# credential ("Nick, bastrop_tx staff pilot") for automated/lane use -- request a
# separate, verification-scoped key instead so it can be rotated without touching
# the operator's own access.

# Local/unit-test bypass ONLY for the above (parseTenantKeyMap; ignored on Cloud Run,
# where K_SERVICE is set) -- a JSON object mapping a raw key value straight to a
# cityKey, e.g. {"<raw key value>":"bastrop_tx"}. Never commit a real key's raw value;
# set this only in a local, gitignored .env for offline dev.
# HAUSKA_TENANT_KEYS=

# Optional. Atom-read HTTP to retrieval. Falls back to HAUSKA_ENGINE_API_KEY. Not a DSN.
# HAUSKA_RETRIEVAL_API_KEY=

# Optional. Required for municode calendar files writes. Not a DSN.
# SMART_FILES_API_KEY=
# Optional write actor. Defaults to cityKey / g71-calendar so the folder is tenant:template-city.
# SMART_FILES_ACTOR_ORG=template-city
# SMART_FILES_ACTOR_USER=g71-calendar
